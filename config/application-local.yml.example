# Copy to  config/application-local.yml  (git-ignored) for per-developer overrides.
# Loaded via  spring.config.import: optional:file:./config/application-local.yml
# Real environments (CI / staging / prod) use environment variables instead — see
# docs/DEPLOYMENT.md §4 for the full env-var contract.

spring:
  datasource:
    druid:
      master:
        # local MySQL without TLS certs:
        url: jdbc:mysql://localhost:3306/ry-vue?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=GMT%2B8
        username: root
        password:            # empty if your local root has no password
  data:
    redis:
      host: localhost
      port: 6379
      password:
  # outbound email — only needed if nadoumi.mail.transport=smtp (below).
  # Default dev = Mailpit from docker-compose.yml (localhost:1025, no auth).
#  mail:
#    host: smtp.gmail.com
#    port: 587
#    username: you@gmail.com
#    password: your-16-char-app-password
#    properties: { mail: { smtp: { auth: true, starttls: { enable: true } } } }

#nadoumi:
#  mail:
#    transport: smtp          # log | smtp
#    dev-inbox:
#      # Enable ONLY for local Playwright E2E: mounts the anonymous
#      # GET /api/dev/mail/latest that the readOtp helper polls. Off by default.
#      enabled: true

# token:
#   secret: <your own 64+ char secret>   # optional locally; a dev default ships in application.yml

# TOKEN_SECRET is required at startup: the context now fails fast if it's still
# the publicly-committed dev default. For local dev/tests only, opt in instead
# of setting a real secret (config/application-druid.yml already does this for
# this checkout):
#token:
#  dev-secret-allowed: true

# Media storage: CLOUDINARY_URL is required at startup (fails fast if absent).
# Either set a real cloudinary://<key>:<secret>@<cloud> (env var or here), or, for
# local dev only, opt into the unauthenticated local-filesystem fallback — never
# set this outside local development, it serves PROTECTED documents over the
# same anonymous path as PUBLIC assets:
#nadoumi:
#  media:
#    allow-local-fallback: true
