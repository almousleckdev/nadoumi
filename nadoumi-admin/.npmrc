# ESLint 8 (legacy .eslintrc) resolves plugins from the project-root node_modules.
# pnpm nests transitive plugins (e.g. @typescript-eslint/* pulled in by
# @vue/eslint-config-typescript) by default, so hoist the eslint toolchain.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=@typescript-eslint/*
