<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nadoumi.notification.mapper.NotificationRecipientMapper">

    <select id="findEmail" resultType="java.lang.String">
        select email from sys_user
        where user_id = #{userId} and del_flag = '0' and email is not null and email &lt;&gt; ''
    </select>

</mapper>
