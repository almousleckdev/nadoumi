<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nadoumi.application.mapper.WfDefinitionMapper">

    <resultMap id="definition" type="com.nadoumi.application.domain.WfDefinition">
        <id     property="id"         column="id"/>
        <result property="code"       column="code"/>
        <result property="name"       column="name"/>
        <result property="version"    column="version"/>
        <result property="status"     column="status"/>
        <result property="createBy"   column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy"   column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark"     column="remark"/>
    </resultMap>

    <resultMap id="stage" type="com.nadoumi.application.domain.WfStage">
        <id     property="id"           column="id"/>
        <result property="definitionId" column="definition_id"/>
        <result property="code"         column="code"/>
        <result property="name"         column="name"/>
        <result property="orderNo"      column="order_no"/>
        <result property="stageType"    column="stage_type"/>
        <result property="statusLabel"  column="status_label"/>
        <result property="slaHours"     column="sla_hours"/>
    </resultMap>

    <resultMap id="transition" type="com.nadoumi.application.domain.WfTransition">
        <id     property="id"           column="id"/>
        <result property="definitionId" column="definition_id"/>
        <result property="code"         column="code"/>
        <result property="fromStageId"  column="from_stage_id"/>
        <result property="toStageId"    column="to_stage_id"/>
        <result property="guardJson"    column="guard_json"/>
        <result property="roleRequired" column="role_required"/>
        <result property="auto"         column="auto"/>
    </resultMap>

    <resultMap id="taskTemplate" type="com.nadoumi.application.domain.WfStageTaskTemplate">
        <id     property="id"            column="id"/>
        <result property="stageId"       column="stage_id"/>
        <result property="title"         column="title"/>
        <result property="roleRequired"  column="role_required"/>
        <result property="mandatory"     column="mandatory"/>
        <result property="blocksExit"    column="blocks_exit"/>
        <result property="orderNo"       column="order_no"/>
    </resultMap>

    <select id="findById" resultMap="definition">
        select * from nad_wf_definition where id = #{id}
    </select>

    <select id="findActiveByCode" resultMap="definition">
        select * from nad_wf_definition where code = #{code} and status = 'ACTIVE' limit 1
    </select>

    <select id="findAllVersions" resultMap="definition">
        select * from nad_wf_definition where code = #{code} order by version desc
    </select>

    <select id="list" resultMap="definition">
        select * from nad_wf_definition order by code, version desc
    </select>

    <insert id="insert" parameterType="com.nadoumi.application.domain.WfDefinition"
            useGeneratedKeys="true" keyProperty="id">
        insert into nad_wf_definition (code, name, version, status, create_by, create_time)
        values (#{code}, #{name}, #{version}, #{status}, #{createBy}, now())
    </insert>

    <update id="updateStatus">
        update nad_wf_definition set status = #{status}, update_time = now() where id = #{id}
    </update>

    <select id="findStages" resultMap="stage">
        select * from nad_wf_stage where definition_id = #{definitionId} order by order_no
    </select>

    <select id="findStageById" resultMap="stage">
        select * from nad_wf_stage where id = #{id}
    </select>

    <select id="findTransitions" resultMap="transition">
        select * from nad_wf_transition where definition_id = #{definitionId}
    </select>

    <select id="findTransitionsFrom" resultMap="transition">
        select * from nad_wf_transition
        where definition_id = #{definitionId}
          and (from_stage_id = #{fromStageId} or (from_stage_id is null and #{fromStageId} is null))
    </select>

    <select id="findTransition" resultMap="transition">
        select * from nad_wf_transition
        where definition_id = #{definitionId} and code = #{code}
          and (from_stage_id = #{fromStageId} or (from_stage_id is null and #{fromStageId} is null))
        limit 1
    </select>

    <select id="findTaskTemplates" resultMap="taskTemplate">
        select * from nad_wf_stage_task_template where stage_id = #{stageId} order by order_no
    </select>

</mapper>
