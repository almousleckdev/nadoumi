<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nadoumi.document.mapper.DocumentTemplateMapper">

    <resultMap id="template" type="com.nadoumi.document.domain.DocumentTemplate">
        <id     property="id"         column="id"/>
        <result property="scope"      column="scope"/>
        <result property="refId"      column="ref_id"/>
        <result property="title"      column="title"/>
        <result property="fileName"   column="file_name"/>
        <result property="mediaId"    column="media_id"/>
        <result property="createBy"   column="create_by"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="cols">id, scope, ref_id, title, file_name, media_id, create_by, create_time</sql>

    <insert id="insert" parameterType="com.nadoumi.document.domain.DocumentTemplate"
            useGeneratedKeys="true" keyProperty="id">
        insert into nad_document_template (scope, ref_id, title, file_name, media_id, create_by, create_time)
        values (#{scope}, #{refId}, #{title}, #{fileName}, #{mediaId}, #{createBy}, now())
    </insert>

    <select id="findByScope" resultMap="template">
        select <include refid="cols"/> from nad_document_template
        where scope = #{scope} and ref_id = #{refId} order by id
    </select>

    <select id="findById" resultMap="template">
        select <include refid="cols"/> from nad_document_template where id = #{id}
    </select>

    <delete id="delete">delete from nad_document_template where id = #{id}</delete>
</mapper>
